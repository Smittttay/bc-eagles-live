<body class="dashboard-page">

<header class="eagles-banner">
  <div class="banner-content">
    <div class="banner-monogram"><img src="/static/assets/bc-logo.png" alt="Boston College Eagles" class="actual-bc-logo"></div>
    <div class="banner-title">
      <span>BOSTON COLLEGE</span>
      <h1>EAGLES LIVE</h1>
    </div>
    <div class="banner-motto">Ever<br>to Excel</div>
  </div>
  <div class="stadium-art" aria-hidden="true"></div>
</header>

<nav class="eagles-nav" aria-label="Main navigation">
  <a href="#home" class="nav-active">⌂ Home</a>
  <a href="#live">◉ Live Games</a>
  <a href="#full-schedule" id="nav-schedule">▦ Schedule</a>
  <a href="#sports">◈ Sports</a>
  <a href="#recent">★ Scores</a>
  <div class="notification-control">
    <button id="open-alert-settings" type="button"
      aria-label="Notifications and sounds"
      aria-controls="alerts" aria-expanded="false">♬ <span class="nav-bell">🔔</span></button>
  </div>
</nav>

<section class="section alert-dropdown" id="alerts" hidden>
  <h2>🔔 Notifications & Sounds</h2>
  <div class="alert-settings">
    <label class="alert-check">
      <input type="checkbox" id="alert-enabled" checked>
      Enable scoring celebrations
    </label>
    <label for="alert-sound">Scoring sound</label>
    <select id="alert-sound">
      <option value="horn">Stadium Horn</option>
      <option value="siren">Victory Siren</option>
      <option value="chime">Classic Chime</option>
      <option value="fight">For Boston - BC Marching Band</option>
      <option value="silent">Silent</option>
    </select>
    <label for="opponent-sound">Opponent scoring sound</label>
    <select id="opponent-sound">
      <option value="trombone" selected>Low Trombone</option>
      <option value="silent">Silent</option>
    </select>

    <label class="alert-check">
      <input type="checkbox" id="alert-vibrate" checked>
      Vibrate when supported
    </label>
    <button type="button" id="test-score" class="test-score">
      ▶ TEST EAGLES SCORE!
    </button>
    <p class="alert-note">In-app alerts only. Background notifications coming later.</p>
  </div>
</section>

<main class="dashboard-main" id="home">
  <div class="dashboard-columns">
    <div class="dashboard-primary">

      <section class="featured-game">
        <div class="feature-label">▦ NEXT GAME</div>
        <div class="featured-content">
          <div class="feature-bc"><img src="/static/assets/bc-logo.png" alt="Boston College Eagles" class="actual-bc-logo"></div>
          <div class="feature-details">
            <div class="feature-sport" id="feature-sport">BOSTON COLLEGE ATHLETICS</div>
            <h2 id="feature-matchup">Finding the next Eagles game…</h2>
            <p id="feature-date"></p>
            <p id="feature-location"></p>
            <a id="feature-link" class="gold-action"
               href="https://bceagles.com" target="_blank"
               rel="noopener noreferrer">GAME DETAILS →</a>
          </div>
        </div>
      </section>

      <section class="dashboard-panel" id="sports">
        <div class="panel-heading">
          <h2>🏆 BROWSE BY SPORT</h2>
          <button id="all-sports" type="button" class="text-action">All Sports →</button>
        </div>
        <div id="sports-grid" class="sport-tiles"></div>
      </section>

      <section class="dashboard-panel" id="upcoming">
        <div class="panel-heading">
          <h2>▦ GAMES THIS WEEK</h2>
          <button id="view-schedule" type="button" class="text-action">
            View Full Schedule →
          </button>
        </div>
        <div id="status" class="dashboard-status">Connecting to BC Athletics…</div>
        <div id="bc-game-center" class="bc-game-center"></div>
        <div id="games" class="upcoming-list"></div>
        <button id="refresh" class="refresh-action" type="button">↻ Refresh Games</button>
      </section>

      <section class="dashboard-panel full-schedule" id="full-schedule" hidden>
        <div class="panel-heading">
          <h2>FULL SCHEDULE</h2>
          <button id="close-schedule" class="text-action" type="button">Close ✕</button>
        </div>
        <label for="sport-filter">Filter by sport</label>
        <select id="sport-filter"><option value="all">All Sports</option></select>
        <div id="schedule" class="upcoming-list"></div>
      </section>

    </div>

    <aside class="dashboard-sidebar">
      <section class="live-panel" id="live">
        <div class="panel-heading">
          <h2>◉ LIVE NOW</h2>
        </div>
        <div class="live-empty">
          <div class="live-symbol">◉</div>
          <strong>Live scores coming soon</strong>
          <p>Live game detection will appear here once connected to verified scoring feeds.</p>
        </div>
      </section>

      <section class="dashboard-panel" id="recent">
        <div class="panel-heading">
          <h2>🏆 RECENT SCORES</h2>
        </div>
        <div id="recent-games" class="recent-list">
          <p>Checking official results…</p>
        </div>
      </section>

      <section class="dashboard-panel sidebar-about">
        <h2>EVER TO EXCEL</h2>
        <p>Every Eagle. Every sport. One place.</p>
        <p class="source-note">Schedules provided by BC Athletics.</p>
      </section>
    </aside>
  </div>
</main>

<div id="score-celebration" class="score-celebration"
     role="status" aria-live="polite" hidden>
  <div class="celebration-content">
    <div class="celebration-eagle">BC</div>
    <h2 id="celebration-title">EAGLES SCORE!</h2>
    <p>GO EAGLES!</p>
    <button type="button" id="close-celebration">Close</button>
  </div>
</div>

