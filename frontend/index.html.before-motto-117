<!-- BROWSE BY SPORT LABEL FIX V51 -->
<script>
(function () {
  function fixSportLabels() {
    const headings = Array.from(
      document.querySelectorAll(
        ".sport-tile, .dashboard-sport-tile, #sports-grid, .sports-grid"
      )
    );

    headings.forEach(container => {
      const walker = document.createTreeWalker(
        container,
        NodeFilter.SHOW_TEXT
      );

      const nodes = [];
      while (walker.nextNode()) nodes.push(walker.currentNode);

      nodes.forEach(node => {
        const original = node.nodeValue;
        const updated = original
          .replace(/Women['’]?s\s+Lacrosse/gi, "Lacrosse")
          .replace(/Women['’]?s\s+Field Hockey/gi, "Field Hockey");

        if (updated !== original) node.nodeValue = updated;
      });
    });
  }

  document.addEventListener("DOMContentLoaded", function () {
    fixSportLabels();

    const target =
      document.getElementById("sports-grid") ||
      document.querySelector(".sports-grid") ||
      document.body;

    new MutationObserver(fixSportLabels).observe(target, {
      childList: true,
      subtree: true
    });
  });
})();
</script>







